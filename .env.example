# ==============================================================================
# BriskSMS Environment Configuration Template
# Copy this file to .env and configure for your local environment
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Base URLs
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:4200

# PostgreSQL Database (Authoritative Persistence Layer)
POSTGRES_USER=brisksms
POSTGRES_PASSWORD=brisksms_dev_secret
POSTGRES_DB=brisksms_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://brisksms:brisksms_dev_secret@localhost:5432/brisksms_dev?schema=public

# Redis Broker (BullMQ Background Queues & Worker Heartbeats)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Optional Unix domain socket path for local sandboxed Redis instances:
REDIS_SOCKET_PATH=

# Background Worker & Transactional Outbox Configuration
WORKER_CONCURRENCY=4
OUTBOX_POLL_INTERVAL_MS=1000
WORKER_HEARTBEAT_TTL_SECONDS=30

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=replace_with_secure_random_string_min_32_chars_for_jwt
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_secure_random_string_min_32_chars_for_refresh
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Key (AES-256-GCM Master Key - 64 hex characters / 32 bytes)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Sentry Telemetry (Optional for local dev)
SENTRY_DSN=

# Bulk SMS Aggregator Gateways (Product B)
BEEM_API_KEY=
BEEM_SECRET_KEY=
DARSMS_API_KEY=
EHUB_API_KEY=

