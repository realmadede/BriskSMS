# ==============================================================================
# BriskSMS Environment Configuration Template
# Copy this file to .env and configure for your local environment
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Base URLs
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:4200

# PostgreSQL Database (Authoritative Persistence Layer)
POSTGRES_USER=brisksms
POSTGRES_PASSWORD=replace_with_dev_postgres_password
POSTGRES_DB=brisksms_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://brisksms:replace_with_dev_postgres_password@localhost:5432/brisksms_dev

# Redis Broker (BullMQ Background Queues & Worker Heartbeats)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Optional Unix domain socket path for local sandboxed Redis instances:
REDIS_SOCKET_PATH=

# Background Worker & Transactional Outbox Configuration
WORKER_CONCURRENCY=4
OUTBOX_POLL_INTERVAL_MS=1000
WORKER_HEARTBEAT_TTL_SECONDS=30

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=replace_with_secure_random_string_min_32_chars_for_jwt
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_secure_random_string_min_32_chars_for_refresh
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Key (AES-256-GCM Master Key - 64 hex characters / 32 bytes)
ENCRYPTION_MASTER_KEY=replace_with_64_hex_character_master_key

# CSRF & Platform Admin Secrets (Required in production)
CSRF_SECRET=replace_with_secure_random_string_min_32_chars_for_csrf
PLATFORM_ADMIN_SECRET=replace_with_secure_random_string_min_24_chars_for_platform_admin
STRICT_MIGRATION_CHECKSUMS=true
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
REQUIRE_EMAIL_VERIFICATION=false
PASSWORD_RESET_EXPIRY_MINUTES=60
GOOGLE_NONCE_TTL_SECONDS=300
PG_POOL_MAX=15

# Carrier STK Push Live Dispatch Flag (Must remain false until verified telco credentials & callbacks are provisioned)
ENABLE_LIVE_CARRIER_STK=false
MPESA_CALLBACK_SECRET=
MIXX_CALLBACK_SECRET=
AIRTEL_CALLBACK_SECRET=
HALOPESA_CALLBACK_SECRET=

# Sentry Telemetry (Optional for local dev)
SENTRY_DSN=

# Cellular SMS Gateway Relay (Product B - SMSGate VPS behind Cloudflare / External Relay)
SMSGATE_BASE_URL=https://gateway.brisksms.com/api/v1
SMSGATE_API_TOKEN=
SMSGATE_WEBHOOK_SECRET=

# Google Merchant Sign-In (OAuth 2.0 / OpenID Connect ID Token Verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend Transactional Email & Token Verification
RESEND_API_KEY=
RESEND_FROM_EMAIL=BriskSMS <verify@brisksms.com>
EMAIL_VERIFICATION_EXPIRY_HOURS=24
FRONTEND_URL=http://localhost:4200



