{
  "$schema": "https://json.schemastore.org/design-tokens",
  "name": "BriskSMS Design Tokens",
  "version": "1.0.0",
  "color": {
    "light": {
      "canvasBase": "#EAE6DF",
      "canvasDeep": "#DCD6CB",
      "surfaceGlass": "rgba(255, 255, 255, 0.65)",
      "surfaceActive": "rgba(236, 236, 240, 0.85)",
      "surfaceSolid": "#F5F3EF",
      "accentPrimary": "#C2B28F",
      "accentHover": "#B2A27E",
      "contrastPill": "#121212",
      "textPrimary": "#121212",
      "textSecondary": "#666666",
      "textTertiary": "#8E8A82",
      "borderHairline": "rgba(18, 18, 18, 0.08)",
      "statusVerified": "#2E7D32",
      "statusReview": "#ED6C02",
      "statusRejected": "#D32F2F"
    },
    "dark": {
      "canvasBase": "#141416",
      "canvasDeep": "#1A1A1E",
      "surfaceGlass": "rgba(32, 32, 36, 0.65)",
      "surfaceActive": "rgba(60, 60, 65, 0.75)",
      "surfaceSolid": "#1E1E22",
      "accentPrimary": "#D4C5A2",
      "accentHover": "#C5B590",
      "contrastPill": "#FFFFFF",
      "textPrimary": "#FFFFFF",
      "textSecondary": "#A0A0A8",
      "textTertiary": "#6E6E76",
      "borderHairline": "rgba(255, 255, 255, 0.12)",
      "statusVerified": "#4CAF50",
      "statusReview": "#FF9800",
      "statusRejected": "#F44336"
    }
  },
  "typography": {
    "fontFamily": "Plus Jakarta Sans, Inter Display, -apple-system, BlinkMacSystemFont, sans-serif",
    "fontFamilyMono": "JetBrains Mono, SF Mono, Menlo, monospace",
    "displayHero": {
      "fontSize": "clamp(40px, 6vw + 1rem, 76px)",
      "fontWeight": "700",
      "letterSpacing": "-0.035em",
      "lineHeight": "1.05"
    },
    "headline1": {
      "fontSize": "clamp(28px, 3.5vw + 0.5rem, 44px)",
      "fontWeight": "600",
      "letterSpacing": "-0.025em",
      "lineHeight": "1.15"
    },
    "headline2": {
      "fontSize": "clamp(22px, 2.5vw + 0.5rem, 32px)",
      "fontWeight": "600",
      "letterSpacing": "-0.02em",
      "lineHeight": "1.2"
    },
    "bodyLarge": {
      "fontSize": "clamp(16px, 1.2vw + 0.5rem, 18px)",
      "fontWeight": "400",
      "lineHeight": "1.55"
    },
    "bodyRegular": {
      "fontSize": "15px",
      "fontWeight": "400",
      "lineHeight": "1.5"
    },
    "caption": {
      "fontSize": "13px",
      "fontWeight": "500",
      "letterSpacing": "+0.01em",
      "lineHeight": "1.4"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "48px",
    "4xl": "64px"
  },
  "radius": {
    "pill": "9999px",
    "card": "18px",
    "surface": "24px",
    "control": "10px"
  },
  "elevation": {
    "diffuse": "0 8px 32px -4px rgba(45, 40, 30, 0.06), 0 1px 2px rgba(45, 40, 30, 0.04)",
    "floating": "0 16px 48px -8px rgba(45, 40, 30, 0.12), 0 2px 6px rgba(45, 40, 30, 0.06)",
    "glassInset": "inset 0 0 0 0.5px rgba(18, 18, 18, 0.08)"
  },
  "breakpoints": {
    "compactMobile": "320px",
    "standardMobile": "390px",
    "tabletPortrait": "768px",
    "tabletLandscape": "1024px",
    "desktopStandard": "1280px",
    "desktopWide": "1440px",
    "television": "1920px"
  }
}
