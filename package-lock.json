{
  "name": "brisksms-monorepo",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "brisksms-monorepo",
      "version": "1.0.0",
      "license": "SEE LICENSE IN LICENSE",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "node_modules/@brisksms/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@brisksms/db": {
      "resolved": "packages/db",
      "link": true
    },
    "node_modules/@brisksms/parser-engine": {
      "resolved": "packages/parser-engine",
      "link": true
    },
    "node_modules/@brisksms/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/config": {
      "name": "@brisksms/config",
      "version": "1.0.0",
      "license": "SEE LICENSE IN LICENSE"
    },
    "packages/db": {
      "name": "@brisksms/db",
      "version": "1.0.0",
      "license": "SEE LICENSE IN LICENSE",
      "devDependencies": {
        "@brisksms/config": "*"
      }
    },
    "packages/parser-engine": {
      "name": "@brisksms/parser-engine",
      "version": "1.0.0",
      "license": "SEE LICENSE IN LICENSE",
      "dependencies": {
        "@brisksms/shared": "*"
      },
      "devDependencies": {
        "@brisksms/config": "*"
      }
    },
    "packages/shared": {
      "name": "@brisksms/shared",
      "version": "1.0.0",
      "license": "SEE LICENSE IN LICENSE",
      "devDependencies": {
        "@brisksms/config": "*"
      }
    }
  }
}
